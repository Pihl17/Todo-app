@page
@model TodoesModel
@{
	ViewData["Title"] = "Todoes";
}

<section>
    
    @foreach (var todo in Model.ToDoList)
    {
        <div>
            <h2>@todo.Title</h2>
            <p>creation date @todo.CreationDate</p>
            <a class="nav-link text-dark" asp-page="/Todo" asp-route-id="@todo.Id">View</a>
            <a class="nav-link text-dark" asp-page="/Update" asp-route-id="@todo.Id">Edit</a>
            <form method="post">
                <input type="hidden" id="id" name="id" value="@todo.Id" required />
                <button>Delete</button>
            </form>
        </div>
    }

</section>
