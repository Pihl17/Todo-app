@page
@model TodoesModel
@{
	ViewData["Title"] = "Todoes";
}

<section>
    @foreach (var todo in Model.ToDoList)
    {
        <div id="@todo.Id">
            <h2>@todo.Title</h2>
            <p>creation date @todo.CreationDate</p>
            <a class="nav-link text-dark" asp-page="/Todo" asp-route-id="@todo.Id">View</a>
            <a class="nav-link text-dark" asp-page="/Update" asp-route-id="@todo.Id">Edit</a>
            <form method="post" class="delete">
                <input type="hidden" id="id" name="id" value="@todo.Id" required />
                <button type="submit">Delete</button>
            </form>
        </div>
    }
</section>

<script>
    document.querySelectorAll(".delete").forEach(form => {
        form.addEventListener("submit", async function(e) {
        e.preventDefault(); // Prevent page reload

        const form = e.target;
        const id = form.querySelector('[name="id"]').value;

        const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
        });

        if (!response.ok) {
            throw new Error("Failed to delete todo.");
            return
        }
        document.getElementById(id)?.remove();

        form.reset(); // Clear the form after success
        });
    });
</script>